{
  "info": {
    "name": "Dompet (local)",
    "_postman_id": "d0mpe7-0000-0000-0000-000000000001",
    "description": "Local FastAPI/Docker deployment of Dompet. Auth is a plain X-User-Id header (no Cognito locally) — set the `userId` collection variable to a real Cognito UUID that already has data, e.g. 999a05bc-70e1-703d-9eec-df6fd20b8113.\n\nCreate requests have a test script that captures the returned id into a collection variable (accountId, transactionId, locationId, tagId, categoryId) so the folders below can be run top-to-bottom with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "userId", "value": "999a05bc-70e1-703d-9eec-df6fd20b8113" },
    { "key": "accountId", "value": "" },
    { "key": "destinationAccountId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "locationId", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "operationId", "value": "" }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{base_url}}/accounts?include_inactive=false",
              "host": ["{{base_url}}"],
              "path": ["accounts"],
              "query": [{ "key": "include_inactive", "value": "false" }]
            }
          }
        },
        {
          "name": "Create account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('accountId', body.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CHECKING\",\n  \"name\": \"Checking Account\",\n  \"description\": \"Created from Postman\"\n}"
            },
            "url": { "raw": "{{base_url}}/accounts", "host": ["{{base_url}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Create destination account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('destinationAccountId', body.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"MERCHANT\",\n  \"name\": \"Test Merchant\",\n  \"description\": \"Created from Postman\"\n}"
            },
            "url": { "raw": "{{base_url}}/accounts", "host": ["{{base_url}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{base_url}}/accounts/{{accountId}}",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{accountId}}"]
            }
          }
        },
        {
          "name": "Edit account",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated from Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/{{accountId}}",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{accountId}}"]
            }
          }
        },
        {
          "name": "Deactivate account",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{base_url}}/accounts/{{accountId}}/deactivate",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{accountId}}", "deactivate"]
            }
          }
        },
        {
          "name": "Reactivate account",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{base_url}}/accounts/{{accountId}}/reactivate",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{accountId}}", "reactivate"]
            }
          }
        }
      ]
